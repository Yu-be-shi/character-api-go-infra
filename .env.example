# このファイルを .env にコピーして値を埋めてください（.env は .gitignore 済み・コミット禁止）。
# この compose スタック（character-api + Redis）が読む変数のみを置く。
# 省略時は docker-compose.yml のデフォルト値が使われる。

# application 側（character-application-nextjs）の INTERNAL_API_KEY と必ず同じ値にすること。
# 不一致だと character-api が 401 を返す。生成: openssl rand -hex 32
INTERNAL_API_KEY=replace_with_random_32byte_hex

# キャラクター DB の接続情報（character-db-infra 側の .env と同じ値にする）
CHAR_DB_NAME=characters
CHAR_DB_USER=app
CHAR_DB_PASSWORD=devpassword

# 冪等性キー用 Redis（この API 専有）。空にすると冪等性機能は無効。
REDIS_ADDR=character-api-redis:6379

# CORS 許可オリジン / ログレベル / レート制限（0=無効）
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info
# RATE_LIMIT_RPS=0

# 予約パターンの TTL 回収（確定されなかった作成 pending を回収）。既定 1h / 10m。
# RESERVATION_SWEEP_INTERVAL=0 でスイーパー無効。
# RESERVATION_TTL=1h
# RESERVATION_SWEEP_INTERVAL=10m
